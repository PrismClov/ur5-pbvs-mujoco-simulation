     return max(response_time, send_time + duration + settle_margin)
 
 
+def adaptive_gain_parameters(
+    *,
+    enabled: bool,
+    feature_rms_px: float,
+    target_speed_px_s: float,
+    target_speed_available: bool,
+    base_gain: float,
+    boosted_gain: float,
+    base_max_linear_speed: float,
+    boosted_max_linear_speed: float,
+    large_error_start_px: float,
+    large_error_full_px: float,
+    slow_target_full_px_s: float,
+    slow_target_zero_px_s: float,
+) -> dict[str, float | bool]:
+    """Blend a faster recentering response for slow targets and large error."""
+    if not enabled or not target_speed_available:
+        return {
+            'active': False,
+            'blend': 0.0,
+            'gain': float(base_gain),
+            'max_linear_speed': float(base_max_linear_speed),
+            'error_weight': 0.0,
+            'slow_target_weight': 0.0,
+        }
+    error_span = large_error_full_px - large_error_start_px
+    speed_span = slow_target_zero_px_s - slow_target_full_px_s
+    error_weight = float(np.clip(
+        (feature_rms_px - large_error_start_px) / error_span, 0.0, 1.0))
+    if target_speed_px_s <= slow_target_full_px_s:
+        slow_weight = 1.0
+    elif target_speed_px_s >= slow_target_zero_px_s:
+        slow_weight = 0.0
+    else:
+        slow_weight = (
+            slow_target_zero_px_s - target_speed_px_s) / speed_span
+    error_weight = error_weight * error_weight * (3.0 - 2.0 * error_weight)
+    slow_weight = slow_weight * slow_weight * (3.0 - 2.0 * slow_weight)
+    blend = error_weight * slow_weight
+    return {
+        'active': blend > 0.0,
+        'blend': float(blend),
+        'gain': float(base_gain + (boosted_gain - base_gain) * blend),
+        'max_linear_speed': float(
+            base_max_linear_speed +
+            (boosted_max_linear_speed - base_max_linear_speed) * blend),
+        'error_weight': float(error_weight),
+        'slow_target_weight': float(slow_weight),
+    }
+
+
+def limit_planned_joint_step(
+    current_joints_deg,
+    target_joints_deg,
+    duration_s: float,
+    max_speed_deg_s: float,
+) -> tuple[list[float], float, bool]:
+    """Scale a joint-space target so its planned speed stays below the limit."""
+    current = np.asarray(
+        current_joints_deg, dtype=np.float64).reshape(-1)
+    target = np.asarray(
+        target_joints_deg, dtype=np.float64).reshape(-1)
+    if (
+        current.shape != (6,) or target.shape != (6,) or
+        not np.all(np.isfinite(current)) or
+        not np.all(np.isfinite(target)) or
+        duration_s <= 0.0 or max_speed_deg_s <= 0.0
+    ):
+        raise ValueError('invalid planned joint step')
+    delta_deg = target - current
+    requested = float(np.max(np.abs(delta_deg)) / duration_s)
+    if requested <= max_speed_deg_s:
+        return target.tolist(), requested, False
+    scale = max_speed_deg_s / requested
+    return (current + delta_deg * scale).tolist(), requested, True
+
